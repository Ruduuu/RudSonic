# Environment Variables — RudSonic Backend
# Copy this file to .env.local and fill in your real keys.
# NEVER commit .env.local to git.

# ── Jamendo API ───────────────────────────────────────────────
# Used for: Music tab (600,000+ CC tracks, max 5 min duration)
# Get free Client ID: https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=YOUR_JAMENDO_CLIENT_ID_HERE

# ── API League ────────────────────────────────────────────────
# Used for: Sound Effects tab (50,000+ CC0 Pixabay sounds, max 30s)
# Get free API Key: https://apileague.com/console/
API_LEAGUE_KEY=YOUR_API_LEAGUE_KEY_HERE
