# Environment Variables — RudSonic Backend
# Copy this file to .env.local and fill in your real key.
# NEVER commit .env.local to git.

# ── Jamendo API ───────────────────────────────────────────────
# Used for: Music tab (600,000+ CC tracks)
# Get your free Client ID at: https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=YOUR_JAMENDO_CLIENT_ID_HERE

# ── Internet Archive ──────────────────────────────────────────
# Used for: Sound Effects tab (500,000+ CC/public domain SFX)
# NO API KEY NEEDED — archive.org is completely open and free!
